# Modelo de ambiente da Balaio de Gato.
#
# Copie para `.env.local` e preencha. Nunca versione segredo: `.env*` está no
# .gitignore. A descrição completa de cada variável está em ENV.md — este
# arquivo lista apenas o que o código lê hoje.

# ============================================
# Base pública
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# `true` somente no domínio público final.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ============================================
# PostgreSQL (Neon, sa-east-1)
# ============================================
# Conexão pooled, usada pelo Next.js em runtime.
DATABASE_URL=
# Conexão direta, preferida por migrations, seed e drizzle-kit.
DATABASE_URL_UNPOOLED=

# ============================================
# Dados protegidos do pedido
# ============================================
# Cifra o CPF do responsável e gera o índice cego de consulta. Mínimo de 32
# bytes, exclusiva por ambiente e obrigatória em deploy. Trocar sem plano de
# rotação torna ilegíveis os CPFs já gravados.
ORDER_DATA_ENCRYPTION_KEY=
# Validade inicial da reserva de estoque, em minutos inteiros positivos.
ORDER_RESERVATION_TTL_MINUTES=1440

# ============================================
# Painel /admin
# ============================================
# Senha de acesso (mínimo de 8 caracteres).
ADMIN_PANEL_PASSWORD=
# Assina o cookie de sessão; mínimo de 32 caracteres.
ADMIN_PANEL_SESSION_SECRET=

# ============================================
# Catálogo
# ============================================
# Andaime: enquanto o catálogo do banco for o seed `draft`, sem isto a loja
# mostra zero produto. Sai quando o catálogo oficial for publicado.
ALLOW_DEVELOPMENT_CATALOG=true
# Fotos de produto no Vercel Blob; a Vercel injeta ao ligar o store.
BLOB_READ_WRITE_TOKEN=

# ============================================
# Gate de manutenção
# ============================================
# 1/true/on serve a página de manutenção com HTTP 503 em toda rota pública.
MAINTENANCE_MODE=
# Segredo aleatório; ?preview=<token> destrava o site enquanto o gate está no ar.
MAINTENANCE_BYPASS_TOKEN=

# ============================================
# E-mail transacional (Resend)
# ============================================
# Sem estas duas o envio devolve `skipped` e a interface deixa de prometer
# e-mail. O pedido nunca falha por causa de e-mail.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
