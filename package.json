{
  "name": "balaio-de-gato",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/db-seed.ts",
    "db:check": "tsx --conditions=react-server --env-file=.env.local scripts/db-check.ts",
    "db:clear-test-orders": "tsx --conditions=react-server --env-file=.env.local scripts/db-clear-test-orders.ts",
    "db:smoke-catalog": "tsx --conditions=react-server --env-file=.env.local scripts/db-catalog-smoke.ts",
    "db:smoke-funnel": "tsx --conditions=react-server --env-file=.env.local scripts/db-funnel-smoke.ts",
    "db:smoke-fulfillment": "tsx --conditions=react-server --env-file=.env.local scripts/db-fulfillment-smoke.ts",
    "db:smoke-order": "tsx --conditions=react-server --env-file=.env.local scripts/db-order-smoke.ts",
    "db:studio": "drizzle-kit studio",
    "test": "npm run test:design && npm run test:balaio && npm run test:loja",
    "test:design": "tsx --test src/lib/design/contrast.test.ts",
    "test:balaio": "tsx --test src/lib/program/material-escolar.test.ts src/lib/payments/duepay.test.ts",
    "test:loja": "tsx --test src/lib/catalog/query.test.ts src/lib/cart/summary.test.ts src/lib/orders/cpf.test.ts src/lib/orders/order.test.ts src/lib/orders/schema.test.ts src/lib/orders/transitions.test.ts src/lib/panel/product-form.test.ts src/lib/panel/csv.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.27.1",
    "lucide-react": "^0.562.0",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
